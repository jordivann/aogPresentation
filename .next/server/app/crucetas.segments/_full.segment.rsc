21:["$","div",null,{"className":"mx-criterion-body","children":[["$","div","reciclado",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"MAPLASTO MN 111"}],["$","p",null,{"children":"El material no contiene una matriz metálica susceptible de oxidación ferrosa. El INTI midió variaciones de peso de 0,83 %, 0,84 % y 1,17 % tras 24 h de inmersión."}]]}],["$","div","madera",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a madera dura"}],["$","p",null,{"children":"La madera es higroscópica; su estabilidad depende de especie, tratamiento y humedad. No hay ensayo comparativo de estas crucetas."}]]}],["$","div","acero",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a acero galvanizado"}],["$","p",null,{"children":"El galvanizado protege al acero, pero el comportamiento depende de calidad del recubrimiento, ambiente y daños."}]]}],["$","div","prfv",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a PRFV"}],["$","p",null,{"children":"Tampoco presenta corrosión ferrosa; pueden existir otros mecanismos de envejecimiento de la matriz."}]]}]]}]
22:["$","details","Origen del material y circularidad",{"className":"mx-criterion","children":[["$","summary",null,{"children":[["$","span",null,{"className":"mx-index","children":"02"}],["$","span",null,{"className":"mx-criterion-name","children":["Origen del material y circularidad",["$","small",null,{"children":"MAPLASTO declara 100 % de plástico reciclado para su MN 111."}]]}],["$","span",null,{"className":"mx-outcome","children":["Diferencial declarado de MAPLASTO",["$","small",null,{"children":"Trazabilidad por verificar"}]]}],["$","span",null,{"className":"mx-plus","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"mx-criterion-body","children":[["$","div","reciclado",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"MAPLASTO MN 111"}],["$","p",null,{"children":"100 % plástico reciclado según MAPLASTO. Se necesita documentación de trazabilidad y, para comparar impacto ambiental, análisis de ciclo de vida."}]]}],["$","div","madera",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a madera dura"}],["$","p",null,{"children":"Es un recurso renovable si proviene de gestión forestal sostenible, pero la comparación de impacto requiere origen y tratamiento."}]]}],["$","div","acero",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a acero galvanizado"}],["$","p",null,{"children":"Es reciclable y puede contener material reciclado; sin dato de un modelo concreto no corresponde comparar porcentajes."}]]}],["$","div","prfv",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a PRFV"}],["$","p",null,{"children":"La reciclabilidad depende de su formulación y circuito de recuperación."}]]}]]}]]}]
23:["$","details","Aislamiento eléctrico",{"className":"mx-criterion","children":[["$","summary",null,{"children":[["$","span",null,{"className":"mx-index","children":"03"}],["$","span",null,{"className":"mx-criterion-name","children":["Aislamiento eléctrico",["$","small",null,{"children":"Potencial ventaja frente al acero conductor; el nivel real de aislamiento debe verificarse."}]]}],["$","span",null,{"className":"mx-outcome","children":["UNC: >63 kV comunicado",["$","small",null,{"children":"Informe UNC pendiente"}]]}],["$","span",null,{"className":"mx-plus","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"mx-criterion-body","children":[["$","div","reciclado",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"MAPLASTO MN 111"}],["$","p",null,{"children":"El fabricante comunicó ensayo bajo lluvia y dos probetas sin perforación por encima de 63 kV en las condiciones ensayadas. No equivale a tensión admisible de servicio."}]]}],["$","div","madera",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a madera dura"}],["$","p",null,{"children":"Su resistividad cambia con la humedad; las comparaciones requieren condiciones idénticas."}]]}],["$","div","acero",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a acero galvanizado"}],["$","p",null,{"children":"El acero conduce electricidad. El aislamiento de una estructura depende del sistema con sus aisladores y distancias."}]]}],["$","div","prfv",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a PRFV"}],["$","p",null,{"children":"Muchos diseños de PRFV ofrecen propiedades dieléctricas, que deben comprobarse en cada modelo."}]]}]]}]]}]
24:["$","details","Resistencia mecánica demostrada",{"className":"mx-criterion","children":[["$","summary",null,{"children":[["$","span",null,{"className":"mx-index","children":"04"}],["$","span",null,{"className":"mx-criterion-name","children":["Resistencia mecánica demostrada",["$","small",null,{"children":"INTI aporta resultados medidos de MAPLASTO, no una victoria frente a otros materiales."}]]}],["$","span",null,{"className":"mx-outcome","children":["Ensayos INTI disponibles",["$","small",null,{"children":"Sin comparación equivalente"}]]}],["$","span",null,{"className":"mx-plus","aria-hidden":"true","children":"+"}]]}],["$","div",null,{"className":"mx-criterion-body","children":[["$","div","reciclado",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"MAPLASTO MN 111"}],["$","p",null,{"children":"Cinco unidades ensayadas a flexión: esfuerzo máximo informado 400 daN en cada una. Esfuerzo a desplazamiento del 2 %: 151,0 a 197,8 daN. Torsión: inspección satisfactoria en 5/5."}]]}],["$","div","madera",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a madera dura"}],["$","p",null,{"children":"Depende de especie, defectos, sección y estado de humedad. Faltan ensayos de un modelo equivalente."}]]}],["$","div","acero",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a acero galvanizado"}],["$","p",null,{"children":"Tiene elevada rigidez material y métodos de cálculo establecidos, pero la capacidad depende del diseño de la cruceta."}]]}],["$","div","prfv",{"className":"mx-criterion-cell","children":[["$","strong",null,{"children":"Frente a PRFV"}],["$","p",null,{"children":"Depende de fibras, matriz, orientación y geometría. Hace falta ficha de una pieza comparable."}]]}]]}]]}]
