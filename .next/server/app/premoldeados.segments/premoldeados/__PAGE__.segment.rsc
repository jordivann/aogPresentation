27:Tbb2,
        .prem-page {
          overflow: hidden;
        }

        .prem-hero {
          position: relative;
          min-height: 680px;
          display: flex;
          align-items: center;
          color: #ffffff;
          background: #121a1d;
          isolation: isolate;
        }

        .prem-hero-image {
          object-fit: cover;
          object-position: center;
          z-index: -2;
        }

        .prem-hero-overlay {
          position: absolute;
          inset: 0;
          background:
            linear-gradient(
              90deg,
              rgba(8, 19, 23, 0.96) 0%,
              rgba(8, 19, 23, 0.84) 38%,
              rgba(8, 19, 23, 0.24) 100%
            );
          z-index: -1;
        }

        .prem-hero-content {
          width: min(1220px, calc(100% - 64px));
          margin: 0 auto;
          padding: 100px 0 65px;
        }

        .prem-kicker {
          display: block;
          color: #63df98;
          font-size: 12px;
          font-weight: 800;
          letter-spacing: 0.15em;
          margin-bottom: 26px;
        }

        .prem-hero h1 {
          color: #fff;
          font-size: clamp(44px, 6vw, 82px);
          line-height: 1.06;
          letter-spacing: -0.055em;
          max-width: 950px;
          margin: 0 0 28px;
        }

        .prem-hero h1 span {
          color: #65dd98;
        }

        .prem-hero p {
          color: #dce6e7;
          font-size: 17px;
          line-height: 1.7;
          max-width: 590px;
          margin-bottom: 30px;
        }

        .prem-hero-actions {
          display: flex;
          gap: 14px;
          flex-wrap: wrap;
          margin-bottom: 85px;
        }

        .prem-hero-bottom {
          display: flex;
          gap: 35px;
          flex-wrap: wrap;
          border-top: 1px solid rgba(255,255,255,.25);
          padding-top: 22px;
          color: #d1dddd;
          font-size: 11px;
          font-weight: 700;
          letter-spacing: .07em;
        }

        .prem-page section[id] {
          scroll-margin-top: 75px;
        }

        @media (max-width: 700px) {
          .prem-hero {
            min-height: 650px;
            align-items: flex-end;
          }

          .prem-hero-image {
            object-position: 60% center;
          }

          .prem-hero-overlay {
            background: linear-gradient(
              0deg,
              rgba(8,19,23,.97),
              rgba(8,19,23,.82) 55%,
              rgba(8,19,23,.25)
            );
          }

          .prem-hero-content {
            width: calc(100% - 36px);
            padding: 100px 0 40px;
          }

          .prem-hero h1 {
            font-size: clamp(40px, 10vw, 58px);
          }

          .prem-hero p {
            font-size: 14px;
          }

          .prem-hero-actions {
            margin-bottom: 55px;
          }

          .prem-hero-bottom {
            gap: 15px;
            font-size: 10px;
          }
        }
